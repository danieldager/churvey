{
  "manifest_version": 2,
  "name": "Chat UI Research Probe (Firefox)",
  "version": "0.2.0",
  "description": "Captures AI chat responses at the network layer (webRequest) in a real logged-in Firefox session, with automated asking. Research tool.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "downloads",
    "cookies",
    "webRequest",
    "webRequestBlocking",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://chat.mistral.ai/*",
    "https://pbs.twimg.com/*",
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "persistent": true,
    "scripts": [
      "src/shared/ext.js",
      "src/shared/namespace.js",
      "src/shared/logger.js",
      "src/shared/storage.js",
      "src/shared/providers.js",
      "src/shared/messages.js",
      "src/shared/cadence.js",
      "src/shared/run-plan.js",
      "src/shared/prompt-template.js",
      "src/shared/record.js",
      "src/shared/summary.js",
      "src/background/capture.js",
      "src/background/citations.js",
      "src/background/runner.js",
      "src/background/isolation.js",
      "src/background/probe.js",
      "src/background/background.js",
      "src/background/autostart.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*"
      ],
      "run_at": "document_start",
      "js": [
        "src/content/visibility.js"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*"
      ],
      "run_at": "document_idle",
      "js": [
        "src/shared/ext.js",
        "src/shared/namespace.js",
        "src/shared/logger.js",
        "src/shared/cadence.js",
        "src/shared/messages.js",
        "src/shared/providers.js",
        "src/content/injector.js",
        "src/content/drivers.js",
        "src/content/page-state.js",
        "src/content/driver.js"
      ]
    }
  ],
  "browser_action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Chat UI Research Probe"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chat-probe@research.local",
      "strict_min_version": "115.0"
    }
  }
}
